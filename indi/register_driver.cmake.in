# Generated from register_driver.cmake.in by indi/CMakeLists.txt — do not edit.
# One-time, idempotent registration of the AstroMount <device> entries in the
# monolithic INDI drivers list used by KStars/Ekos (/usr/share/indi/drivers.xml).
# Runs at `cmake --install` time (as root). Only inserts a block if missing.

set(_drivers_xml "@INDI_DATA_DIR@/drivers.xml")

if(NOT EXISTS "${_drivers_xml}")
    message(WARNING "AstroMount: ${_drivers_xml} not found — skipping drivers.xml registration")
    return()
endif()

file(READ "${_drivers_xml}" _content)

# ── Telescope driver ────────────────────────────────────────────────
if(NOT _content MATCHES "astro_mount_indi_driver")
    set(_mount_block "        <device label=\"AstroMount\" manufacturer=\"AstroMountController\">\n            <driver name=\"AstroMount\">astro_mount_indi_driver</driver>\n            <version>2.0</version>\n        </device>")
    string(REPLACE "<devGroup group=\"Telescopes\">"
                   "<devGroup group=\"Telescopes\">\n${_mount_block}"
                   _content "${_content}")
    message(STATUS "AstroMount: registered telescope driver in ${_drivers_xml}")
else()
    message(STATUS "AstroMount: telescope driver already registered in drivers.xml")
endif()

# ── CCD camera driver ────────────────────────────────────────────────
if(NOT _content MATCHES "astro_mount_ccd")
    set(_ccd_block "        <device label=\"AstroMount Camera\" manufacturer=\"AstroMountController\">\n            <driver name=\"AstroMount CCD\">astro_mount_ccd</driver>\n            <version>2.0</version>\n        </device>")
    string(REPLACE "<devGroup group=\"CCDs\">"
                   "<devGroup group=\"CCDs\">\n${_ccd_block}"
                   _content "${_content}")
    message(STATUS "AstroMount: registered CCD driver in ${_drivers_xml}")
else()
    message(STATUS "AstroMount: CCD driver already registered in drivers.xml")
endif()

file(WRITE "${_drivers_xml}" "${_content}")
