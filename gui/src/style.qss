/* ═══════════════════════════════════════════════════════════════════════════
   Astro Mount Control - Qt GUI Stylesheet
   Mirrors the web interface design: dark theme, card-based layout
   ═══════════════════════════════════════════════════════════════════════════ */

/* ─── Global ──────────────────────────────────────────────────────────────── */
QWidget {
    background-color: #0f0f1a;
    color: #e0e0e0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0f0f1a;
}

/* ─── Header ──────────────────────────────────────────────────────────────── */
QWidget#headerBar {
    background-color: #1a1a2e;
    border-bottom: 1px solid #2a2a4a;
    min-height: 48px;
    max-height: 48px;
}

QWidget#headerBar QLabel#appTitle {
    font-size: 16px;
    font-weight: 600;
    color: #e0e0e0;
    padding: 0 4px;
}

/* Connection input fields in header */
QWidget#headerBar QLineEdit {
    padding: 2px 6px;
    font-size: 11px;
    min-height: 20px;
    max-height: 24px;
    background-color: #0f0f1a;
    border: 1px solid #2a2a4a;
    border-radius: 4px;
    color: #e0e0e0;
}

QWidget#headerBar QLineEdit:focus {
    border-color: #4fc3f7;
}

/* Connect button in header */
QWidget#headerBar QPushButton {
    padding: 2px 10px;
    font-size: 11px;
    min-height: 20px;
    max-height: 24px;
}

/* Font size combo in header */
QWidget#headerBar QComboBox {
    padding: 1px 4px;
    font-size: 11px;
    min-height: 20px;
    max-height: 24px;
    background-color: #0f0f1a;
    border: 1px solid #2a2a4a;
    border-radius: 4px;
    color: #e0e0e0;
}

QWidget#headerBar QComboBox:focus {
    border-color: #4fc3f7;
}

QWidget#headerBar QComboBox::drop-down {
    width: 16px;
    border: none;
}

QWidget#headerBar QComboBox QAbstractItemView {
    background-color: #1a1a2e;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    selection-background-color: #16213e;
}

/* Connection Badge */
QWidget#connectionBadge {
    background-color: rgba(211, 47, 47, 0.1);
    border: 1px solid #d32f2f;
    border-radius: 20px;
    padding: 3px 10px;
}

QWidget#connectionBadge[connected="true"] {
    background-color: rgba(102, 187, 106, 0.1);
    border-color: #66bb6a;
}

QWidget#connectionBadge QLabel#badgeDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background-color: #d32f2f;
}

QWidget#connectionBadge[connected="true"] QLabel#badgeDot {
    background-color: #66bb6a;
}

QWidget#connectionBadge QLabel {
    font-size: 11px;
    font-weight: 500;
    color: #d32f2f;
    background: transparent;
}

QWidget#connectionBadge[connected="true"] QLabel {
    color: #66bb6a;
}

/* ─── Tab Widget ──────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: #0f0f1a;
    padding: 12px;
}

QTabWidget::tab-bar {
    alignment: left;
    background-color: #1a1a2e;
    border-bottom: 1px solid #2a2a4a;
}

QTabBar::tab {
    background: transparent;
    color: #a0a0b0;
    padding: 8px 14px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
    font-weight: 500;
    min-width: 60px;
}

QTabBar::tab:hover {
    color: #e0e0e0;
}

QTabBar::tab:selected {
    color: #4fc3f7;
    border-bottom: 2px solid #4fc3f7;
}

QTabBar::tab:!selected {
    margin-top: 0px;
}

/* ─── Cards (QGroupBox) ───────────────────────────────────────────────────── */
QGroupBox {
    background-color: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 10px;
    margin-top: 8px;
    padding: 0;
    font-weight: 600;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 10px 16px;
    background-color: #16213e;
    border-bottom: 1px solid #2a2a4a;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    color: #e0e0e0;
}

/* Card header layout widget */
QWidget#cardHeader {
    background-color: #16213e;
    border-bottom: 1px solid #2a2a4a;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 0;
}

QWidget#cardHeader QLabel {
    font-size: 13px;
    font-weight: 600;
    color: #e0e0e0;
    padding: 6px 16px;
    background: transparent;
}

/* Card body */
QWidget#cardBody {
    background-color: #1a1a2e;
    padding: 12px 16px;
}

/* ─── Status Badge ────────────────────────────────────────────────────────── */
QLabel#statusBadge {
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #78909c;
    background-color: rgba(120, 144, 156, 0.15);
}

QLabel#statusBadge[slewing="true"] {
    color: #ffa726;
    background-color: rgba(255, 167, 38, 0.1);
}

QLabel#statusBadge[tracking="true"] {
    color: #66bb6a;
    background-color: rgba(102, 187, 106, 0.1);
}

QLabel#statusBadge[parked="true"] {
    color: #42a5f5;
    background-color: rgba(66, 165, 245, 0.15);
}

QLabel#statusBadge[error="true"] {
    color: #d32f2f;
    background-color: rgba(211, 47, 47, 0.1);
}

/* ─── Stat Rows ───────────────────────────────────────────────────────────── */
QLabel.stat-label {
    font-size: 11px;
    color: #a0a0b0;
    font-weight: 500;
}

QLabel.stat-value {
    font-size: 12px;
    color: #e0e0e0;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-weight: 500;
}

QLabel.stat-value[highlight="true"] {
    color: #4fc3f7;
}

QLabel.stat-value[warning="true"] {
    color: #ffa726;
}

QLabel.stat-value[danger="true"] {
    color: #d32f2f;
}

QLabel.stat-value[success="true"] {
    color: #66bb6a;
}

/* ─── Form Controls ───────────────────────────────────────────────────────── */
QLineEdit, QDoubleSpinBox, QSpinBox {
    padding: 8px 10px;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    background-color: #0f0f1a;
    color: #e0e0e0;
    font-size: 13px;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    selection-background-color: rgba(79, 195, 247, 0.3);
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #4fc3f7;
}

QComboBox {
    padding: 8px 10px;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    background-color: #0f0f1a;
    color: #e0e0e0;
    font-size: 13px;
    min-height: 20px;
}

QComboBox:focus {
    border-color: #4fc3f7;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    border-left: 1px solid #2a2a4a;
}

QComboBox QAbstractItemView {
    background-color: #1a1a2e;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    selection-background-color: #16213e;
    selection-color: #4fc3f7;
}

/* ─── Buttons ─────────────────────────────────────────────────────────────── */
QPushButton {
    padding: 8px 14px;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #2a2a4a;
}

QPushButton:pressed {
    background-color: #1a1a2e;
}

QPushButton:disabled {
    opacity: 0.5;
}

/* Primary button */
QPushButton[primary="true"] {
    background-color: #4fc3f7;
    color: #000;
    border: none;
}

QPushButton[primary="true"]:hover {
    background-color: #6dd0fa;
}

/* Danger button */
QPushButton[danger="true"] {
    background-color: #d32f2f;
    color: #fff;
    border: none;
}

QPushButton[danger="true"]:hover {
    background-color: #e53935;
}

/* Warning button */
QPushButton[warning="true"] {
    background-color: #ffa726;
    color: #000;
    border: none;
}

QPushButton[warning="true"]:hover {
    background-color: #ffb94d;
}

/* Emergency stop */
QPushButton#emergencyStop {
    background-color: #d32f2f;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 14px;
    border: none;
    border-radius: 6px;
}

QPushButton#emergencyStop:hover {
    background-color: #e53935;
}

/* ─── Directional Pad Buttons ─────────────────────────────────────────────── */
QPushButton.axis-btn {
    min-width: 96px;
    min-height: 96px;
    max-width: 96px;
    max-height: 96px;
    font-size: 28px;
    border-radius: 6px;
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
}

QPushButton.axis-btn:hover {
    background-color: rgba(79, 195, 247, 0.1);
    border-color: #4fc3f7;
}

QPushButton.axis-btn:pressed {
    background-color: rgba(79, 195, 247, 0.15);
    border-color: #4fc3f7;
}

/* ─── Sliders ─────────────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background-color: #2a2a4a;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #4fc3f7;
    border: 2px solid #1a1a2e;
    width: 20px;
    height: 20px;
    margin: -8px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background-color: #6dd0fa;
}

QSlider::sub-page:horizontal {
    background-color: #4fc3f7;
    border-radius: 3px;
}

/* ─── Progress Bar ────────────────────────────────────────────────────────── */
QProgressBar {
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    background-color: #0f0f1a;
    text-align: center;
    color: #e0e0e0;
    font-size: 11px;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #4fc3f7;
    border-radius: 5px;
}

/* ─── Scrollbars ──────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #0f0f1a;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #2a2a4a;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #3a3a5a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0f0f1a;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #2a2a4a;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a3a5a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ─── Table ───────────────────────────────────────────────────────────────── */
QTableWidget {
    background-color: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    gridline-color: #2a2a4a;
    selection-background-color: rgba(79, 195, 247, 0.15);
    color: #e0e0e0;
}

QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QHeaderView::section {
    background-color: #16213e;
    color: #a0a0b0;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #2a2a4a;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

/* ─── Checkbox ────────────────────────────────────────────────────────────── */
QCheckBox {
    color: #e0e0e0;
    font-size: 12px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2a2a4a;
    border-radius: 3px;
    background-color: #0f0f1a;
}

QCheckBox::indicator:checked {
    background-color: #4fc3f7;
    border-color: #4fc3f7;
}

/* ─── Radio Button ────────────────────────────────────────────────────────── */
QRadioButton {
    color: #e0e0e0;
    font-size: 12px;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2a2a4a;
    border-radius: 9px;
    background-color: #0f0f1a;
}

QRadioButton::indicator:checked {
    background-color: #4fc3f7;
    border-color: #4fc3f7;
}

/* ─── Label ───────────────────────────────────────────────────────────────── */
QLabel {
    color: #e0e0e0;
    background: transparent;
}

QLabel.section-label {
    font-size: 10px;
    font-weight: 600;
    color: #6c6c80;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 8px 0 4px 0;
    margin-top: 2px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

QLabel.placeholder {
    color: #6c6c80;
    font-size: 13px;
    padding: 20px;
    qproperty-alignment: 'AlignCenter';
}

/* ─── List Widget ─────────────────────────────────────────────────────────── */
QListWidget {
    background-color: #0f0f1a;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    color: #e0e0e0;
    outline: none;
}

QListWidget::item {
    padding: 8px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    background-color: #0f0f1a;
}

QListWidget::item:hover {
    background-color: #16213e;
    border: 1px solid #2a2a4a;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: rgba(79, 195, 247, 0.1);
    color: #4fc3f7;
}

/* ─── Status Bar ──────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #1a1a2e;
    border-top: 1px solid #2a2a4a;
    color: #6c6c80;
    font-size: 10px;
    min-height: 24px;
    max-height: 24px;
}

QStatusBar::item {
    border: none;
}

/* ─── Menu Bar ────────────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #1a1a2e;
    border-bottom: 1px solid #2a2a4a;
    color: #a0a0b0;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #16213e;
    color: #e0e0e0;
}

QMenu {
    background-color: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    padding: 4px;
    color: #e0e0e0;
}

QMenu::item {
    padding: 6px 30px 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #16213e;
    color: #4fc3f7;
}

QMenu::separator {
    height: 1px;
    background: #2a2a4a;
    margin: 4px 10px;
}

/* ─── Tooltip ─────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a1a2e;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ─── Splitter ────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2a2a4a;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #4fc3f7;
}
