{
    "_comment": "====================================================================",
    "_comment1": "Independent configuration for LingKong MF7025v2 BLDC servo drives",
    "_comment2": "Uses proprietary CAN protocol (not CANopen/CiA 402)",
    "_comment3": "Usage: ./astro_mount_control config/mf7025v2.json",
    "_comment4": "====================================================================",

    "logging": {
        "level": "INFO",
        "directory": "/var/log/astro-mount",
        "console_output": true
    },

    "network": {
        "grpc_address": "0.0.0.0",
        "grpc_port": 50051,
        "max_connections": 10,
        "enable_ssl": false,
        "ssl_cert_path": "certs/server.crt",
        "ssl_key_path": "certs/server.key"
    },

    "mount": {
        "type": "equatorial",
        "latitude": 52.0,
        "longitude": 21.0,
        "altitude": 100.0,
        "default_temperature": 15.0,
        "default_pressure": 1013.25,
        "default_humidity": 0.5,
        "use_encoders": false,
        "encoders_absolute": false,
        "encoder_resolution": 262144,

        "max_slew_rate": 1000.0,
        "max_tracking_rate": 1.504,
        "slew_acceleration": 10.0,
        "tracking_acceleration": 0.001,

        "position_tolerance": 0.1,
        "rate_tolerance": 0.01,

        "meridian_flip_enabled": true,
        "meridian_flip_delay_minutes": 5.0,
        "meridian_flip_hysteresis_degrees": 0.5,
        "meridian_flip_timeout_seconds": 120.0,

        "soft_limits_enabled": true,
        "soft_limit_axis1_min": -360.0,
        "soft_limit_axis1_max": 360.0,
        "soft_limit_axis2_min": -90.0,
        "soft_limit_axis2_max": 90.0,
        "soft_limit_warning_degrees": 10.0,
        "soft_limit_deceleration_degrees": 5.0,
        "soft_limit_tracking_rate_factor": 0.1,

        "park_position_axis1": 0.0,
        "park_position_axis2": 90.0,

        "enable_refraction_correction": true,
        "equatorial_tracking_velocity_mode": true,
        "invert_axis1": false,
        "invert_axis2": false,
        "controller_poll_ms": 50,
        "tracking_update_ms": 20,
        "orientation_quaternion": [1.0, 0.0, 0.0, 0.0],

        "axis_physical_parameters": {
            "ha_axis": {
                "position_counts_per_degree": 100.0,
                "velocity_counts_per_deg_s": 100.0,
                "encoder_resolution": 262144.0,
                "encoder_counts_per_arcsec": 4.943847656,
                "encoder_quantization_error": 39.6,
                "gear_ratio": 360.0,
                "worm_ratio": 360.0,
                "worm_teeth": 1,
                "worm_wheel_teeth": 360,
                "cyclic_error_amplitude": 15.2,
                "cyclic_error_period": 360.0,
                "cyclic_harmonics": [10.5, 0.0, 3.2, 1.5708, 1.1, 3.1416, 0.5, 4.7124],
                "backlash": 8.5,
                "backlash_temp_coeff": 0.02,
                "axis_stiffness": 0.5,
                "torsional_compliance": 1.0e-6,
                "expansion_coeff": 11.0e-6,
                "temp_gear_error_coeff": 0.05,
                "calibration_temp": 20.0,
                "calibration_table": []
            },
            "dec_axis": {
                "position_counts_per_degree": 100.0,
                "velocity_counts_per_deg_s": 100.0,
                "encoder_resolution": 262144.0,
                "encoder_counts_per_arcsec": 4.943847656,
                "encoder_quantization_error": 39.6,
                "gear_ratio": 360.0,
                "worm_ratio": 360.0,
                "worm_teeth": 1,
                "worm_wheel_teeth": 360,
                "cyclic_error_amplitude": 12.8,
                "cyclic_error_period": 360.0,
                "cyclic_harmonics": [8.2, 0.0, 2.5, 1.5708, 0.8, 3.1416, 0.3, 4.7124],
                "backlash": 6.3,
                "backlash_temp_coeff": 0.015,
                "axis_stiffness": 0.6,
                "torsional_compliance": 1.2e-6,
                "expansion_coeff": 11.0e-6,
                "temp_gear_error_coeff": 0.04,
                "calibration_temp": 20.0,
                "calibration_table": []
            }
        }
    },

    "telescope": {
        "focal_length": 2000.0,
        "aperture": 200.0,
        "tube_length": 1800.0,
        "camera_model": "ASI1600",
        "pixel_size": 3.8,
        "sensor_width": 4656,
        "sensor_height": 3520
    },

    "guider": {
        "enabled": false,
        "connection_string": "",
        "max_correction": 10.0,
        "aggression": 0.5,
        "exposure_time_ms": 2000,
        "binning": 2
    },

    "kalman": {
        "process_noise": 0.01,
        "measurement_noise": 1.0,
        "adaptive_q": true,
        "adaptive_r": false,
        "innovation_threshold": 3.0,
        "max_iterations": 10
    },

    "tpoint": {
        "enabled_terms": 65535,
        "min_measurements": 10,
        "max_residual": 30.0,
        "auto_calibrate": true
    },

    "field_rotation": {
        "enabled": false,
        "latitude": 52.0,
        "altitude": 0.0,
        "azimuth": 0.0,
        "computed_rate": 0.0,
        "applied_correction": 0.0,
        "temperature": 15.0,
        "flexure_correction": 0.0
    },

    "hal": {
        "_comment": "================== HAL: LingKong MF7025v2 BLDC ==================",
        "type": "mf7025v2",
        "name": "LingKong_BLDC_Mount_MF7025v2",

        "mf7025v2": {
            "_comment": "MF7025v2 proprietary CAN bus configuration",
            "can_interface": "can0",
            "bitrate": 1000000,
            "sdo_timeout_ms": 100,
            "position_units_per_degree": 728.177777778,
            "velocity_units_per_dps": 100.0,
            "can_trace": true,
            "can_trace_read_state": false,
            "status_poll_ms": 50,
            "absolute_position_poll_ms": 100
        },

        "axes": [
            {
                "_comment": "HA axis (Hour Angle / RA / Azimuth) — MF7025v2 node 1",
                "id": 0,
                "name": "HA_Axis",
                "can_node_id": 1,

                "motor_config": {
                    "type": "BRUSHLESS_DC",
                    "default_mode": "POSITION",
                    "max_velocity": 1000.0,
                    "max_acceleration": 1.0,
                    "max_torque": 100.0,
                    "encoder_counts_per_degree": 262144.0,
                    "gear_ratio": 360.0,
                    "enable_current_limit": true,
                    "current_limit": 5.0,
                    "enable_temperature_protection": true,
                    "max_temperature": 80.0
                },

                "encoder_config": {
                    "type": "ABSOLUTE",
                    "interface": "CANOPEN",
                    "resolution": 262144,
                    "counts_per_degree": 728.177777778,
                    "use_index_pulse": true,
                    "use_direction_signal": true,
                    "max_velocity": 1000.0,
                    "enable_error_detection": true,
                    "error_threshold": 10,
                    "calibration_offset": 0.0
                },

                "safety_limits": {
                    "min_position": -360.0,
                    "max_position": 360.0,
                    "max_velocity": 1000.0,
                    "max_acceleration": 2.0,
                    "max_current": 10.0,
                    "max_temperature": 80.0
                }
            },
            {
                "_comment": "Dec axis (Declination / Altitude) — MF7025v2 node 2",
                "id": 1,
                "name": "Dec_Axis",
                "can_node_id": 2,

                "motor_config": {
                    "type": "BRUSHLESS_DC",
                    "default_mode": "POSITION",
                    "max_velocity": 1000.0,
                    "max_acceleration": 1.0,
                    "max_torque": 100.0,
                    "encoder_counts_per_degree": 262144.0,
                    "gear_ratio": 360.0,
                    "enable_current_limit": true,
                    "current_limit": 5.0,
                    "enable_temperature_protection": true,
                    "max_temperature": 80.0
                },

                "encoder_config": {
                    "type": "ABSOLUTE",
                    "interface": "CANOPEN",
                    "resolution": 262144,
                    "counts_per_degree": 100.0,
                    "use_index_pulse": true,
                    "use_direction_signal": true,
                    "max_velocity": 1000.0,
                    "enable_error_detection": true,
                    "error_threshold": 10,
                    "calibration_offset": 0.0
                },

                "safety_limits": {
                    "min_position": -90.0,
                    "max_position": 90.0,
                    "max_velocity": 1000.0,
                    "max_acceleration": 2.0,
                    "max_current": 10.0,
                    "max_temperature": 80.0
                }
            }
        ],

        "gamepad": {
            "_comment": "Gamepad manual control (optional, disabled by default)",
            "device_path": "",
            "deadzone": 0.15,
            "sensitivity": 1.0,
            "max_velocity_deg_s": 500.0,
            "invert_axis1": false,
            "invert_axis2": false,
            "speed_presets": [5.0, 10.0, 50.0, 200.0, 500.0],
            "update_rate_hz": 50.0,
            "autostart": false,
            "gamepad_mode": 0,

            "button_mapping": {
                "0": "home",
                "1": "stop",
                "2": "park",
                "3": "emergency_stop",
                "4": "speed_down",
                "5": "speed_up",
                "6": "manual_toggle"
            },
            "axis_mapping": {
                "0": "lx",
                "1": "ly",
                "2": "trigger_l",
                "3": "rx",
                "4": "ry",
                "5": "trigger_r",
                "16": "pov_x",
                "17": "pov_y"
            }
        },

        "pid_params": {
            "kp": 1.5,
            "ki": 0.2,
            "kd": 0.05,
            "integral_limit": 1000.0,
            "output_limit": 100.0,
            "anti_windup_gain": 0.1,
            "enable_anti_windup": true
        },

        "safety": {
            "enable_limits": true,
            "enable_emergency_stop": true,
            "emergency_stop_timeout_ms": 100,
            "enable_temperature_monitoring": true,
            "enable_current_monitoring": true,
            "enable_voltage_monitoring": true,
            "min_voltage": 20.0,
            "max_voltage": 30.0,
            "monitoring_rate": 10
        }
    }
}
