{
    "_comment": "====================================================================",
    "_comment1": "Configuration for NiMotion STM42M CANopen/CiA 402 servo drive",
    "_comment2": "Usage: ./astro_mount_controller config/canopen_stm42m.json",
    "_comment3": "Closed-loop encoder: 4000 counts/turn (608Fh:01h = 4000) — manual factory default",
    "_comment4": "Node IDs: axis 0 = 1, axis 1 = 2",
    "_comment5": "====================================================================",

    "logging": {
        "level": "INFO",
        "directory": "/var/log/astro-mount",
        "console_output": true
    },

    "network": {
        "grpc_address": "0.0.0.0",
        "grpc_port": 50051,
        "max_connections": 10,
        "enable_ssl": false,
        "ssl_cert_path": "certs/server.crt",
        "ssl_key_path": "certs/server.key"
    },

    "mount": {
        "type": "equatorial",
        "latitude": 52.0,
        "longitude": 21.0,
        "altitude": 100.0,
        "default_temperature": 15.0,
        "default_pressure": 1013.25,
        "default_humidity": 0.5,
        "use_encoders": true,
        "encoders_absolute": true,
        "encoder_resolution": 4000,

        "max_slew_rate": 500.0,
        "max_tracking_rate": 1.504,
        "slew_acceleration": 1.0,
        "tracking_acceleration": 0.001,

        "position_tolerance": 0.1,
        "rate_tolerance": 0.01,

        "meridian_flip_enabled": true,
        "meridian_flip_delay_minutes": 5.0,
        "meridian_flip_hysteresis_degrees": 0.5,
        "meridian_flip_timeout_seconds": 120.0,

        "soft_limits_enabled": true,
        "soft_limit_axis1_min": -270.0,
        "soft_limit_axis1_max": 270.0,
        "soft_limit_axis2_min": -5.0,
        "soft_limit_axis2_max": 185.0,
        "soft_limit_warning_degrees": 10.0,
        "soft_limit_deceleration_degrees": 5.0,
        "soft_limit_tracking_rate_factor": 0.1,

        "park_position_axis1": 0.0,
        "park_position_axis2": 90.0,

        "enable_refraction_correction": true,
        "equatorial_tracking_velocity_mode": false,
        "invert_axis1": false,
        "invert_axis2": false,
        "controller_poll_ms": 50,
        "tracking_update_ms": 20,
        "orientation_quaternion": [1.0, 0.0, 0.0, 0.0],

        "axis_physical_parameters": {
            "ha_axis": {
                "_comment": "enkoder 4000 counts/obrót (608Fh:01h=4000); counts/stopień = 4000/360",
                "position_counts_per_degree": 142.22222222,
                "velocity_counts_per_deg_s": 142.22222222,
                "encoder_resolution": 4000.0,
                "encoder_counts_per_arcsec": 0.003086,
                "encoder_quantization_error": 324.0,
                "gear_ratio": 360.0,
                "worm_ratio": 360.0,
                "worm_teeth": 1,
                "worm_wheel_teeth": 180,
                "cyclic_error_amplitude": 15.2,
                "cyclic_error_period": 360.0,
                "cyclic_harmonics": [10.5, 0.0, 3.2, 1.5708, 1.1, 3.1416, 0.5, 4.7124],
                "backlash": 8.5,
                "backlash_temp_coeff": 0.02,
                "axis_stiffness": 0.5,
                "torsional_compliance": 1.0e-6,
                "expansion_coeff": 11.0e-6,
                "temp_gear_error_coeff": 0.05,
                "calibration_temp": 20.0,
                "calibration_table": []
            },
            "dec_axis": {
                "_comment": "enkoder 4000 counts/obrót (608Fh:01h=4000); counts/stopień = 4000/360",
                "position_counts_per_degree": 142.22222222,
                "velocity_counts_per_deg_s": 142.22222222,
                "encoder_resolution": 4000.0,
                "encoder_counts_per_arcsec": 0.003086,
                "encoder_quantization_error": 324.0,
                "gear_ratio": 360.0,
                "worm_ratio": 360.0,
                "worm_teeth": 1,
                "worm_wheel_teeth": 180,
                "cyclic_error_amplitude": 12.8,
                "cyclic_error_period": 360.0,
                "cyclic_harmonics": [8.2, 0.0, 2.5, 1.5708, 0.8, 3.1416, 0.3, 4.7124],
                "backlash": 6.3,
                "backlash_temp_coeff": 0.015,
                "axis_stiffness": 0.6,
                "torsional_compliance": 1.2e-6,
                "expansion_coeff": 11.0e-6,
                "temp_gear_error_coeff": 0.04,
                "calibration_temp": 20.0,
                "calibration_table": []
            }
        }
    },

    "telescope": {
        "focal_length": 2000.0,
        "aperture": 200.0,
        "tube_length": 1800.0,
        "camera_model": "ASI1600",
        "pixel_size": 3.8,
        "sensor_width": 4656,
        "sensor_height": 3520
    },

    "guider": {
        "enabled": false,
        "connection_string": "",
        "max_correction": 10.0,
        "aggression": 0.5,
        "exposure_time_ms": 2000,
        "binning": 2
    },

    "kalman": {
        "process_noise": 0.01,
        "measurement_noise": 1.0,
        "adaptive_q": true,
        "adaptive_r": false,
        "innovation_threshold": 3.0,
        "max_iterations": 10
    },

    "tpoint": {
        "enabled_terms": 65535,
        "min_measurements": 10,
        "max_residual": 30.0,
        "auto_calibrate": true
    },

    "field_rotation": {
        "enabled": false,
        "latitude": 52.0,
        "altitude": 0.0,
        "azimuth": 0.0,
        "computed_rate": 0.0,
        "applied_correction": 0.0,
        "temperature": 15.0,
        "flexure_correction": 0.0
    },

    "servo_init": {
        "_comment": "STM42M CiA 402 init: NMT Operational, CiA402 mode, encoder 4000 counts/turn, PP mode, then 6->7->15",
        "enabled": true,
        "sequence": [
            { "axis": 0, "data_size": 1, "description": "HA: NMT start (Operational)", "index": "0x0000", "subindex": 0, "value": 1 },
            { "axis": 0, "data_size": 2, "description": "HA: CiA402 mode (2002h:01h = 0)", "index": "0x2002", "subindex": 1, "value": 0 },
            { "axis": 0, "data_size": 4, "description": "HA: encoder increments 608Fh:01h = 4000", "index": "0x608F", "subindex": 1, "value": 4000 },
            { "axis": 0, "data_size": 4, "description": "HA: motor revolutions 608Fh:02h = 1", "index": "0x608F", "subindex": 2, "value": 1 },
            { "axis": 0, "data_size": 1, "description": "HA: Profile Position mode (6060h = 1)", "index": "0x6060", "subindex": 0, "value": 1 },
            { "axis": 0, "data_size": 2, "description": "HA: Shutdown (6040h = 6)", "index": "0x6040", "subindex": 0, "value": 6 },
            { "axis": 0, "data_size": 2, "description": "HA: Switch On (6040h = 7)", "index": "0x6040", "subindex": 0, "value": 7 },
            { "axis": 0, "data_size": 2, "description": "HA: Enable Operation (6040h = 15)", "index": "0x6040", "subindex": 0, "value": 15 },
            { "axis": 1, "data_size": 1, "description": "Dec: NMT start (Operational)", "index": "0x0000", "subindex": 0, "value": 1 },
            { "axis": 1, "data_size": 2, "description": "Dec: CiA402 mode (2002h:01h = 0)", "index": "0x2002", "subindex": 1, "value": 0 },
            { "axis": 1, "data_size": 4, "description": "Dec: encoder increments 608Fh:01h = 4000", "index": "0x608F", "subindex": 1, "value": 4000 },
            { "axis": 1, "data_size": 4, "description": "Dec: motor revolutions 608Fh:02h = 1", "index": "0x608F", "subindex": 2, "value": 1 },
            { "axis": 1, "data_size": 1, "description": "Dec: Profile Position mode (6060h = 1)", "index": "0x6060", "subindex": 0, "value": 1 },
            { "axis": 1, "data_size": 2, "description": "Dec: Shutdown (6040h = 6)", "index": "0x6040", "subindex": 0, "value": 6 },
            { "axis": 1, "data_size": 2, "description": "Dec: Switch On (6040h = 7)", "index": "0x6040", "subindex": 0, "value": 7 },
            { "axis": 1, "data_size": 2, "description": "Dec: Enable Operation (6040h = 15)", "index": "0x6040", "subindex": 0, "value": 15 }
        ]
    },

    "hal": {
        "_comment": "====================== HAL: CANopen/CiA 402 (STM42M, 17-bit) ======================",
        "type": "canopen",
        "name": "CANopen_STM42M_Mount",

        "canopen": {
            "library": "canopensocket",
            "interface_name": "can0",
            "bitrate": 1000000,
            "node_id": 1,
            "use_sync": false,
            "sync_period_ms": 100,
            "sdo_timeout_ms": 500,
            "pdo_update_rate": 100,
            "accel_mode": "rate",
            "pdo_config_enabled": true,

            "position_rewind_enabled": true,
            "position_rewind_interval_seconds": 3600.0,
            "position_rewind_threshold_percent": 80.0,

            "nmt": {
                "enable_nmt": true,
                "heartbeat_period_ms": 100,
                "heartbeat_timeout_ms": 500,
                "max_missed_heartbeats": 3,
                "enable_bootup_check": true,
                "bootup_timeout_ms": 5000,
                "enable_auto_recovery": true,
                "recovery_interval_s": 5,
                "enable_node_guarding": false,
                "node_guarding_period_ms": 1000
            }
        },

        "axes": [
            {
                "_comment": "HA axis (Hour Angle / RA / Azimuth)",
                "id": 0,
                "name": "HA_Axis",
                "can_node_id": 1,

                "motor_config": {
                    "type": "STEPPER",
                    "default_mode": "POSITION",
                    "max_velocity": 500.0,
                    "max_acceleration": 1.0,
                    "max_torque": 100.0,
                    "encoder_counts_per_degree": 142.22222222,
                    "gear_ratio": 360.0,
                    "enable_current_limit": true,
                    "current_limit": 500.0,
                    "enable_temperature_protection": true,
                    "max_temperature": 80.0
                },

                "encoder_config": {
                    "type": "ABSOLUTE",
                    "interface": "SSI",
                    "resolution": 4000,
                    "counts_per_degree": 142.22222222,
                    "use_index_pulse": true,
                    "use_direction_signal": true,
                    "max_velocity": 1000.0,
                    "enable_error_detection": true,
                    "error_threshold": 10,
                    "calibration_offset": 0.0
                },

                "safety_limits": {
                    "min_position": -270.0,
                    "max_position": 270.0,
                    "max_velocity": 500.0,
                    "max_acceleration": 2.0,
                    "max_current": 10.0,
                    "max_temperature": 80.0
                }
            },
            {
                "_comment": "Dec axis (Declination / Altitude)",
                "id": 1,
                "name": "Dec_Axis",
                "can_node_id": 2,

                "motor_config": {
                    "type": "STEPPER",
                    "default_mode": "POSITION",
                    "max_velocity": 500.0,
                    "max_acceleration": 1.0,
                    "max_torque": 100.0,
                    "encoder_counts_per_degree": 142.22222222,
                    "gear_ratio": 360.0,
                    "enable_current_limit": true,
                    "current_limit": 5.0,
                    "enable_temperature_protection": true,
                    "max_temperature": 80.0
                },

                "encoder_config": {
                    "type": "ABSOLUTE",
                    "interface": "SSI",
                    "resolution": 4000,
                    "counts_per_degree": 142.22222222,
                    "use_index_pulse": true,
                    "use_direction_signal": true,
                    "max_velocity": 1000.0,
                    "enable_error_detection": true,
                    "error_threshold": 10,
                    "calibration_offset": 0.0
                },

                "safety_limits": {
                    "min_position": -5.0,
                    "max_position": 185.0,
                    "max_velocity": 500.0,
                    "max_acceleration": 2.0,
                    "max_current": 10.0,
                    "max_temperature": 80.0
                }
            }
        ],

        "gamepad": {
            "device_path": "",
            "deadzone": 0.15,
            "sensitivity": 1.0,
            "max_velocity_deg_s": 500.0,
            "invert_axis1": false,
            "invert_axis2": false,
            "speed_presets": [50.0, 100.0, 200.0, 300.0, 500.0],
            "update_rate_hz": 50.0,
            "autostart": false,
            "gamepad_mode": 0,
            "button_mapping": {
                "0": "home",
                "1": "stop",
                "2": "bootstrap_calibrate",
                "3": "emergency_stop",
                "4": "speed_down",
                "5": "speed_up",
                "6": "manual_toggle",
                "7": "park",
                "9": "mode_cycle",
                "10": "clear_errors"
            },
            "axis_mapping": {
                "0": "lx",
                "1": "ly",
                "2": "trigger_l",
                "3": "rx",
                "4": "ry",
                "5": "trigger_r",
                "16": "pov_x",
                "17": "pov_y"
            }
        },

        "pid_params": {
            "kp": 1.5,
            "ki": 0.2,
            "kd": 0.05,
            "integral_limit": 1000.0,
            "output_limit": 100.0,
            "anti_windup_gain": 0.1,
            "enable_anti_windup": true
        },

        "safety": {
            "enable_limits": true,
            "enable_emergency_stop": true,
            "emergency_stop_timeout_ms": 100,
            "enable_temperature_monitoring": true,
            "enable_current_monitoring": true,
            "enable_voltage_monitoring": true,
            "min_voltage": 20.0,
            "max_voltage": 30.0,
            "monitoring_rate": 10
        }
    }
}
